%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6d2622b13d204c9dae82fb000bc92dd, type: 3}
  m_Name: Day_04
  m_EditorClassIdentifier: Assembly-CSharp::DailyMission
  dayName: 'Day 4: The Removal'
  dayMusic: {fileID: 0}
  minigameSceneName: FallingObject
  steps:
  - description: The Diagnosis
    targetNpcID: Director
    dialogueLines:
    - 'Director: Good morning, Unit 0.'
    - 'Director: Your report yesterday regarding the "fake houses" was... concerning.'
    - 'Director: We have detected viral data in your memory. You are confusing nightmares
      with reality.'
    - 'Director: Proceed immediately to the Library.'
    - 'Director: The Librarian has prepared a specific reading list to "soothe" your
      mind. Do not deviate.'
  - description: The Censorship
    targetNpcID: Librarian
    dialogueLines:
    - 'Librarian: Ah, Unit 0. The Director called ahead.'
    - 'Librarian: Here is your book: "The History of Smiles". It has no conflict,
      only happiness.'
    - 'Player: (I take the book. It is just pages of blue colors. I glance at her
      desk.)'
    - 'Player: (Under her ledger, there is a newspaper clipping sticking out. I see
      my face on it.)'
    - 'Librarian: Read the book, citizen. Focus on the colors. Stop staring at my
      desk.'
    - 'Librarian: Read the book, citizen. Focus on the colors. Stop staring at my
      desk.'
  - description: The Forbidden Truth
    targetNpcID: Librarian
    dialogueLines:
    - 'Player: I''m not reading this. I want to know about that paper under your
      hand.'
    - 'Player: It says "Critical Car Accident". That''s me in the photo, isn''t it?'
    - 'Librarian: (She slams her hand down on the paper, trying to hide it.)'
    - 'Librarian: You... you were not supposed to see that! That is corrupted data!'
    - 'Librarian: You are unstable! The book therapy is not enough!'
    - 'Librarian: Go to the Arcade right now! The Supervisor will "clean" your visual
      cortex!'
  - description: The Game Over
    targetNpcID: Supervisor
    dialogueLines:
    - 'Supervisor: Welcome, Unit 0. The Librarian alerted me.'
    - 'Supervisor: You insist on holding onto "painful data". We call that a virus.'
    - 'Player: I want to remember who I am.'
    - 'Supervisor: Memory is inefficient. This machine will fix you.'
    - 'Supervisor: Look at the screen. Your corrupted thoughts will fall like blocks.'
    - 'Supervisor: Dodge them. If they hit you, we wipe the drive.'
    - 'Supervisor: Insert coin. Therapy begins... NOW.'
