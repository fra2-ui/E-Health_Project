%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6d2622b13d204c9dae82fb000bc92dd, type: 3}
  m_Name: Day_06
  m_EditorClassIdentifier: Assembly-CSharp::DailyMission
  dayName: 'Day 6: The Collapse'
  dayMusic: {fileID: 0}
  minigameSceneName: EndlessRun
  steps:
  - description: The Warning
    targetNpcID: Director
    dialogueLines:
    - 'Director: SYSTEM ALERT. SYSTEM ALERT.'
    - 'Director: The "Purge Virus" has been released. The city is being deleted.'
    - 'Player: You can''t just erase everyone!'
    - 'Director: It is too late. The deletion wave has started at the edges of the
      map.'
    - 'Director: If you want to save the core data, you must hurry.'
    - 'Director: Go to the Pub. The Bartender is holding the "Memory Sector Alpha".'
    - 'Director: RUN.'
  - description: The Glitched Pub
    targetNpcID: Bartender
    dialogueLines:
    - 'Bartender: The... bottles... are melting...'
    - 'Player: Listen to me! I''m here to save you!'
    - 'Bartender: NULL_POINTER_EXCEPTION... I can''t... see...'
    - 'Bartender: Take it... take the Key...'
    - 'Bartender: (He hands you a glowing code fragment before freezing completely.)'
    - 'Player: I have the first part. I need to get to the Bakery before the Baker
      is deleted!'
  - description: The Fading Bakery
    targetNpcID: Baker
    dialogueLines:
    - 'Baker: 01000100... Fresh bread... 010101...'
    - 'Player: Baker! Snap out of it!'
    - 'Baker: The oven... it''s cold.'
    - 'Baker: Is this... the end?'
    - 'Player: No. I''m going to stop it. Give me the access code!'
    - 'Baker: Here... "Memory Sector Beta"... Goodbye, traveler.'
    - 'Player: (The Baker vanishes into static.)'
    - 'Player: I have both keys. I have to go back to the Community Center and stop
      the Director!'
  - description: The Final Stand
    targetNpcID: Director
    dialogueLines:
    - 'Director: DELETION PROGRESS: 99%.'
    - 'Player: Stop! I have the Alpha and Beta keys! I override the command!'
    - 'Director: ERROR. OVERRIDE REJECTED.'
    - 'Director: The keys are valid, but the corruption has changed form.'
    - 'Director: The virus is now manifesting as your own Negative Thoughts.'
    - 'Director: Fear. Guilt. Despair. They are raining down to crush your mind.'
    - 'Director: You must dodge them manually. Do not let the negativity touch you.'
    - 'Director: PREPARE FOR IMPACT. AVOID THE DARKNESS. SURVIVE.'
    - (The room turns red. A storm of dark thoughts begins to fall...)
